# Copy to .env.local for local development. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Required only for the protected POST /api/events endpoint.
# Generate a long random secret and keep it server-side.
EVENT_ADMIN_API_KEY=replace-with-a-long-random-secret

# ImageKit is required for event image uploads.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
